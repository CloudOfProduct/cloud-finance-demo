# Cloud Finance - Canlı Veri ve API Ortam Değişkenleri
# NOT: Güvenlik gereği API anahtarları asla istemci (client/browser) kodunda saklanmaz.
# Üretim ortamında bu değişkenler Node.js / Next.js / Express veya API Gateway katmanında tutulmalıdır.

# Lisanslı BIST Veri Sağlayıcı API Bilgileri (Matriks / Foreks / Algolab / Direct FIX)
BIST_PROVIDER_NAME="Matriks / Foreks Direct FIX Feed"
BIST_API_ENDPOINT="https://api.licensed-market-data.com/v2/bist"
BIST_API_KEY="your_secure_server_side_bist_api_key_here"
BIST_API_SECRET="your_secure_server_side_secret_here"
BIST_WS_STREAM_URL="wss://stream.licensed-market-data.com/live"

# Kamuyu Aydınlatma Platformu (KAP) Veri Servisi
KAP_API_ENDPOINT="https://api.kap.gov.tr/v1/disclosures"
KAP_API_KEY="your_secure_server_side_kap_api_key_here"

# Model & Yapay Zeka Entegrasyon Ayarları
AI_ANALYSIS_ENGINE="CloudFinance-BIST-v2"
AI_CONFIDENCE_THRESHOLD=70
UPDATE_INTERVAL_MS=5000
